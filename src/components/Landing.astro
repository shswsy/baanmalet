---
import '../styles/global.css'
import HeroArt from './HeroArt.astro'
import BeanBag from './BeanBag.astro'
import StoryIcon from './StoryIcon.astro'
import CupArt from './CupArt.astro'
import MapArt from './MapArt.astro'
import { beans, days, menu, reviews, site, t, type Lang } from '../data/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const c = t[lang]
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const href = (l: Lang) => `${base}/${l === 'th' ? '' : 'en/'}`
const canonical = new URL(href(lang), Astro.site).href
const ogImage = new URL(`${base}/og.png`, Astro.site).href
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`
const mapEmbed = `https://maps.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&z=16&output=embed&hl=${lang}`
const fmtHours = (h: [number, number] | null) =>
  h ? `${String(h[0]).padStart(2, '0')}:00 – ${String(h[1]).padStart(2, '0')}:00` : c.closed
const price = (n: number) => n.toLocaleString('th-TH')
const featured = menu[0]
const navItems = [
  ['menu', c.nav.menu],
  ['beans', c.nav.beans],
  ['story', c.nav.story],
  ['workshop', c.nav.workshop],
  ['visit', c.nav.visit],
] as const
const num = (n: number) => String(n).padStart(2, '0')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CafeOrCoffeeShop',
  name: site.name[lang],
  description: c.description,
  url: canonical,
  image: ogImage,
  telephone: site.phone,
  servesCuisine: 'Coffee',
  priceRange: '฿฿',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address[lang],
    addressLocality: 'Chiang Mai',
    postalCode: '50200',
    addressCountry: 'TH',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  openingHoursSpecification: site.hours.flatMap((h, i) =>
    h
      ? [
          {
            '@type': 'OpeningHoursSpecification',
            dayOfWeek: `https://schema.org/${days.en[i]}`,
            opens: `${String(h[0]).padStart(2, '0')}:00`,
            closes: `${String(h[1]).padStart(2, '0')}:00`,
          },
        ]
      : [],
  ),
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.title}</title>
    <meta name="description" content={c.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="th" href={new URL(href('th'), Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(href('en'), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('th'), Astro.site).href} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="theme-color" content="#f6f0e6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.title} />
    <meta property="og:description" content={c.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=Prompt:wght@400;500;600&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip" href="#main">{c.skip}</a>

    <header class="nav" data-nav>
      <div class="wrap nav-row">
        <a class="logo" href={href(lang)}>
          <span class="logo-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40"><path d="M20 4C11 12 11 28 20 36C29 28 29 12 20 4Z" fill="currentColor" /><path d="M20 8C16 16 24 24 20 32" stroke="var(--bg)" stroke-width="2.4" fill="none" stroke-linecap="round" /></svg>
          </span>
          <span class="logo-text">
            <strong>{site.name[lang]}</strong>
            <small>{site.tagline[lang]}</small>
          </span>
        </a>
        <nav id="nav-links" class="nav-links" data-nav-links aria-label={lang === 'th' ? 'เมนูหลัก' : 'Main'}>
          {navItems.map(([id, label]) => <a href={`#${id}`} data-spy={id}>{label}</a>)}
          <a class="btn btn-line nav-line-mobile" href="#line" data-line={c.greeting}>
            <span class="line-ico" aria-hidden="true"></span>{c.line}
          </a>
        </nav>
        <div class="nav-actions">
          <div class="lang-switch" role="group" aria-label={lang === 'th' ? 'ภาษา' : 'Language'}>
            <a href={href('th')} hreflang="th" lang="th" aria-current={lang === 'th' ? 'true' : undefined} aria-label="ภาษาไทย">TH</a>
            <a href={href('en')} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} aria-label="English">EN</a>
          </div>
          <a class="btn btn-line btn-sm nav-line" href="#line" data-line={c.greeting}>
            <span class="line-ico" aria-hidden="true"></span>{c.line}
          </a>
          <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label={lang === 'th' ? 'เปิดเมนู' : 'Open menu'} data-menu-btn>
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="wrap">
          <div class="hero-panel">
            <div class="hero-art-wrap">
              <HeroArt label={lang === 'th' ? 'ภาพวาดดอยยามเช้าและกิ่งกาแฟ' : 'Illustration of northern mountains at dawn and a coffee branch'} />
            </div>
            <div class="hero-copy">
              <p class="kicker hero-in">{c.heroKicker}</p>
              <h1 id="hero-title" class="hero-in" style="--d:.08s">
                <span>{c.heroTitle[0]}</span>
                <em>{c.heroTitle[1]}</em>
              </h1>
              <p class="hero-lead hero-in" style="--d:.16s">{c.heroLead}</p>
              <div class="hero-ctas hero-in" style="--d:.24s">
                <a class="btn btn-primary btn-lg" href="#menu">{c.heroCta}<span class="arrow" aria-hidden="true">→</span></a>
                <a class="btn btn-ghost btn-lg" href="#visit">{c.heroCta2}</a>
              </div>
            </div>
          </div>

          <!-- quick info strip: the four things customers look for first -->
          <ul class="info-strip hero-in" style="--d:.32s">
            <li>
              <a href="#visit" class="info-item">
                <span class="info-label">{c.infoToday}</span>
                <span
                  class="open-badge"
                  data-open
                  data-hours={JSON.stringify(site.hours)}
                  data-l-open={c.openNow}
                  data-l-closed={c.closedNow}
                  data-l-closes={c.closesAt}
                  data-l-opens={c.opensAt}
                  data-days={JSON.stringify(days[lang])}
                >
                  <span class="dot" aria-hidden="true"></span><span data-open-text>{fmtHours(site.hours[2])}</span>
                </span>
              </a>
            </li>
            <li>
              <a href={mapsUrl} target="_blank" rel="noopener" class="info-item">
                <span class="info-label">{c.infoWhere}</span>
                <span class="info-value">{lang === 'th' ? 'ซอยนิมมานเหมินท์ เชียงใหม่' : 'Nimmanhaemin, Chiang Mai'}</span>
                <span class="info-more">{c.infoMap} ↗</span>
              </a>
            </li>
            <li>
              <a href={site.phoneHref} class="info-item">
                <span class="info-label">{c.infoCall}</span>
                <span class="info-value">{site.phone}</span>
              </a>
            </li>
            <li>
              <a href="#line" data-line={c.greeting} class="info-item info-line">
                <span class="info-label">{c.infoChat}</span>
                <span class="info-value"><span class="line-ico" aria-hidden="true"></span>{c.line}</span>
                <span class="info-more">{c.infoChatSub}</span>
              </a>
            </li>
          </ul>

          <ul class="stats">
            {
              c.stats.map(([n, l]) => (
                <li class="rv">
                  <strong>{n}</strong>
                  <span>{l}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 01 MENU -->
      <section id="menu" class="section" aria-labelledby="menu-title">
        <div class="wrap">
          <header class="sec-head rv">
            <p class="eyebrow"><span class="num">{num(1)}</span>{c.nav.menu}</p>
            <h2 id="menu-title">{c.menuTitle}</h2>
            <p class="sec-lead">{c.menuLead}</p>
          </header>
          <div class="menu-grid">
            <aside class="featured rv">
              <div class="featured-art"><CupArt /></div>
              <div class="featured-body">
                <p class="featured-kicker">{c.menuFeatured}</p>
                <h3>{featured.name[lang]}</h3>
                <p>{featured.note[lang]}</p>
                <div class="featured-foot">
                  <span class="price-lg">{price(featured.price)}<small>฿</small></span>
                  <a class="btn btn-line btn-sm" href="#line" data-line={c.menuFeaturedMsg}>
                    <span class="line-ico" aria-hidden="true"></span>{c.menuFeaturedCta}
                  </a>
                </div>
              </div>
            </aside>
            <div class="menu-main rv">
              <div class="tabs" role="tablist" aria-label={c.menuTitle} data-tabs>
                {
                  (['all', 'coffee', 'noncoffee', 'bakery'] as const).map((k, i) => (
                    <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-cat={k}>
                      {c.cats[k]}
                      <span class="count">{k === 'all' ? menu.length : menu.filter((m) => m.cat === k).length}</span>
                    </button>
                  ))
                }
              </div>
              <ul class="menu-list" data-menu>
                {
                  menu.map((m) => (
                    <li class="menu-item" data-cat={m.cat}>
                      <div class="menu-top">
                        <h3>{m.name[lang]}</h3>
                        <span class="leader" aria-hidden="true" />
                        <span class="price">{price(m.price)}</span>
                      </div>
                      <p>
                        {m.tag && <span class="tag">{m.tag[lang]}</span>}
                        {m.note[lang]}
                      </p>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 02 BEANS -->
      <section id="beans" class="section section-dark" aria-labelledby="beans-title">
        <div class="wrap">
          <header class="sec-head rv">
            <p class="eyebrow"><span class="num">{num(2)}</span>{c.nav.beans}</p>
            <h2 id="beans-title">{c.beansTitle}</h2>
            <p class="sec-lead">{c.beansLead}</p>
          </header>
          <ul class="beans">
            {
              beans.map((b) => (
                <li class="bean rv" style={`--hue:${b.hue}`}>
                  <div class="bean-art">
                    <BeanBag hue={b.hue} label={b.name[lang]} />
                    <span class="bean-process">{b.process[lang]}</span>
                  </div>
                  <div class="bean-body">
                    <h3>{b.name[lang]}</h3>
                    <p class="bean-origin">{b.origin[lang]}</p>
                    <ul class="bean-notes">
                      {b.notes[lang].split(' · ').map((n) => <li>{n}</li>)}
                    </ul>
                    <div class="roast" role="img" aria-label={`${c.roast} ${b.roast}/5`}>
                      <span>{c.roastScale[0]}</span>
                      <span class="roast-bar">
                        {[1, 2, 3, 4, 5].map((n) => (
                          <i class={n <= b.roast ? 'on' : ''} />
                        ))}
                      </span>
                      <span>{c.roastScale[1]}</span>
                    </div>
                    <div class="bean-foot">
                      <span class="price-lg">
                        {price(b.price)}<small>฿ {c.beansPer}</small>
                      </span>
                      <a class="btn btn-cream btn-sm" href="#line" data-line={c.orderMsg(b.name[lang])}>
                        <span class="line-ico" aria-hidden="true"></span>{c.order}
                      </a>
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- 03 STORY -->
      <section id="story" class="section section-story" aria-labelledby="story-title">
        <div class="wrap">
          <header class="sec-head rv">
            <p class="eyebrow"><span class="num">{num(3)}</span>{c.storyKicker}</p>
            <h2 id="story-title">{c.storyTitle}</h2>
          </header>
          <ol class="story">
            {
              c.story.map(([h, p], i) => (
                <li class="story-row rv">
                  <div class={`story-art story-art-${i}`}>
                    <StoryIcon kind={i as 0 | 1 | 2} />
                  </div>
                  <div class="story-text">
                    <span class="story-no">{num(i + 1)} / {num(c.story.length)}</span>
                    <h3>{h}</h3>
                    <p>{p}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- 04 WORKSHOP -->
      <section id="workshop" class="section section-tight" aria-labelledby="workshop-title">
        <div class="wrap">
          <div class="workshop rv">
            <div class="workshop-copy">
              <p class="eyebrow"><span class="num">{num(4)}</span>{c.nav.workshop}</p>
              <h2 id="workshop-title">{c.workshopTitle}</h2>
              <p class="workshop-lead">{c.workshopLead}</p>
              <ul class="checks">
                {c.workshopPoints.map((p) => <li>{p}</li>)}
              </ul>
              <a class="btn btn-cream btn-lg" href="#line" data-line={c.workshopMsg}>
                <span class="line-ico" aria-hidden="true"></span>{c.workshopCta}
              </a>
            </div>
            <div class="ticket" aria-hidden="true">
              <div class="ticket-top">
                <span class="ticket-day">SAT</span>
                <span class="ticket-time">10:00–12:00</span>
              </div>
              <p class="ticket-label">{c.workshopSeats}</p>
              <span class="ticket-seats">
                {[1, 2, 3, 4, 5, 6].map((n) => <i class={n <= 4 ? 'taken' : ''} />)}
              </span>
              <p class="ticket-left">{c.workshopSeatsLeft}</p>
              <div class="ticket-foot">
                <span>Pour-over 101</span>
                <strong>890 ฿</strong>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 05 VISIT -->
      <section id="visit" class="section section-sand" aria-labelledby="visit-title">
        <div class="wrap">
          <header class="sec-head rv">
            <p class="eyebrow"><span class="num">{num(5)}</span>{c.nav.visit}</p>
            <h2 id="visit-title">{c.visitTitle}</h2>
            <p class="sec-lead">{c.visitLead}</p>
          </header>
          <div class="visit">
            <div class="visit-card rv">
              <div class="visit-block">
                <h3>{c.addressLabel}</h3>
                <address>
                  <strong>{site.name[lang]}</strong>
                  <br />
                  {site.address[lang]}
                </address>
                <p class="muted small">{c.parking}</p>
              </div>
              <div class="visit-block">
                <h3>{c.hoursTitle}</h3>
                <table class="hours" data-hours-table>
                  <tbody>
                    {
                      [1, 2, 3, 4, 5, 6, 0].map((d) => (
                        <tr data-day={d} class={site.hours[d] ? '' : 'is-closed'}>
                          <th scope="row">
                            {days[lang][d]}
                            <span class="today-tag">{c.today}</span>
                          </th>
                          <td>{fmtHours(site.hours[d])}</td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
              <div class="visit-ctas">
                <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener">{c.directions} ↗</a>
                <a class="btn btn-ghost" href={site.phoneHref}>{c.call} {site.phone}</a>
                <a class="btn btn-line" href="#line" data-line={c.greeting}><span class="line-ico" aria-hidden="true"></span>{c.line}</a>
              </div>
            </div>
            <div class="map rv" data-map={mapEmbed}>
              <MapArt name={site.name[lang]} />
              <button type="button" class="map-load" data-map-load>
                <span>{c.mapLoad}</span>
                <small>{c.mapNote}</small>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- 06 REVIEWS -->
      <section class="section" aria-labelledby="reviews-title">
        <div class="wrap">
          <header class="sec-head rv">
            <p class="eyebrow"><span class="num">{num(6)}</span>4.8 ★ · 600+</p>
            <h2 id="reviews-title">{c.reviewsTitle}</h2>
          </header>
          <ul class="reviews">
            {
              reviews.map((r) => (
                <li class="rv">
                  <p class="stars" aria-label="5/5">★★★★★</p>
                  <blockquote>{r.text[lang]}</blockquote>
                  <p class="who">
                    <span class="avatar" aria-hidden="true">{r.who.slice(0, 1)}</span>
                    <span>
                      <strong>{r.who}</strong>
                      <small>{r.src}</small>
                    </span>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <strong class="footer-name">{site.name[lang]}</strong>
            <p>{site.tagline[lang]}</p>
          </div>
          <div>
            <h2 class="footer-h">{c.footerExplore}</h2>
            <ul class="footer-links">
              {navItems.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
            </ul>
          </div>
          <div>
            <h2 class="footer-h">{c.footerContact}</h2>
            <ul class="footer-links">
              <li><a href={site.phoneHref}>{site.phone}</a></li>
              <li><a href="#line" data-line={c.greeting}>LINE</a></li>
              <li><a href={mapsUrl} target="_blank" rel="noopener">{c.directions} ↗</a></li>
              <li><a href={href(lang === 'th' ? 'en' : 'th')} hreflang={lang === 'th' ? 'en' : 'th'}>{c.switchLang}</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">{c.footerNote}</p>
      </div>
    </footer>

    <!-- mobile quick actions -->
    <nav class="quick" aria-label={lang === 'th' ? 'ทางลัด' : 'Quick actions'}>
      <a href={site.phoneHref}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z" fill="currentColor" /></svg>
        {c.call}
      </a>
      <a href="#line" data-line={c.greeting} class="quick-line">
        <span class="line-ico" aria-hidden="true"></span>
        LINE
      </a>
      <a href={mapsUrl} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z" fill="currentColor" /></svg>
        {lang === 'th' ? 'นำทาง' : 'Directions'}
      </a>
    </nav>

    <dialog class="line-dialog" data-line-dialog aria-labelledby="line-title">
      <h2 id="line-title">{c.demoLineTitle}</h2>
      <p>{c.demoLineBody}</p>
      <p class="bubble" data-line-msg></p>
      <form method="dialog"><button class="btn btn-primary">{c.close}</button></form>
    </dialog>

    <script>
      // Open-now badge and today's row, computed in Bangkok time.
      const badge = document.querySelector<HTMLElement>('[data-open]')
      if (badge) {
        const hours: ([number, number] | null)[] = JSON.parse(badge.dataset.hours!)
        const dayNames: string[] = JSON.parse(badge.dataset.days!)
        const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Bangkok' }))
        const d = now.getDay()
        const h = now.getHours() + now.getMinutes() / 60
        const today = hours[d]
        const pad = (n: number) => `${String(n).padStart(2, '0')}:00`
        const open = !!today && h >= today[0] && h < today[1]
        let text: string
        if (open) {
          text = `${badge.dataset.lOpen} · ${badge.dataset.lCloses} ${pad(today![1])}`
        } else {
          let next = d
          let add = 0
          if (!(today && h < today[0])) {
            do {
              next = (next + 1) % 7
              add++
            } while (!hours[next] && add < 7)
          }
          const nh = hours[next]!
          text = `${badge.dataset.lClosed} · ${badge.dataset.lOpens} ${add === 0 ? '' : dayNames[next] + ' '}${pad(nh[0])}`
        }
        badge.classList.toggle('is-open', open)
        badge.querySelector('[data-open-text]')!.textContent = text
        document.querySelector(`[data-hours-table] tr[data-day="${d}"]`)?.classList.add('today')
      }

      // Menu filter
      const tabs = document.querySelector('[data-tabs]')
      tabs?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]')
        if (!btn) return
        tabs.querySelectorAll('button').forEach((b) => b.setAttribute('aria-selected', String(b === btn)))
        const cat = btn.dataset.cat
        document.querySelectorAll<HTMLElement>('[data-menu] .menu-item').forEach((li) => {
          li.hidden = cat !== 'all' && li.dataset.cat !== cat
        })
      })

      // LINE buttons: demo dialog shows the pre-filled message a real LINE OA link would send.
      const dialog = document.querySelector<HTMLDialogElement>('[data-line-dialog]')
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-line]')
        if (!a || !dialog) return
        e.preventDefault()
        dialog.querySelector('[data-line-msg]')!.textContent = a.dataset.line ?? ''
        dialog.showModal()
      })
      dialog?.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close()
      })

      // Google map loads only on request (faster page, no third-party cookies until asked).
      document.querySelector('[data-map-load]')?.addEventListener('click', (e) => {
        const box = (e.currentTarget as HTMLElement).parentElement!
        const iframe = document.createElement('iframe')
        iframe.src = box.dataset.map!
        iframe.title = 'Google Maps'
        iframe.loading = 'lazy'
        iframe.referrerPolicy = 'no-referrer-when-downgrade'
        box.replaceChildren(iframe)
      })

      // Mobile nav
      const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]')
      const links = document.querySelector<HTMLElement>('[data-nav-links]')
      const setMenu = (open: boolean) => {
        menuBtn?.setAttribute('aria-expanded', String(open))
        links?.classList.toggle('open', open)
      }
      menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'))
      links?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) setMenu(false)
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMenu(false)
      })

      // Compact header on scroll
      const nav = document.querySelector('[data-nav]')
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8)
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })

      // Scroll reveals
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('in')
              io.unobserve(en.target)
            }
          }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      )
      document.querySelectorAll('.rv').forEach((el) => io.observe(el))

      // Highlight the nav link for the section in view
      const spyLinks = new Map<string, HTMLElement>()
      document.querySelectorAll<HTMLElement>('[data-spy]').forEach((a) => spyLinks.set(a.dataset.spy!, a))
      const spy = new IntersectionObserver(
        (entries) =>
          entries.forEach((en) => {
            const a = spyLinks.get(en.target.id)
            if (!a) return
            if (en.isIntersecting) {
              spyLinks.forEach((l) => l.removeAttribute('aria-current'))
              a.setAttribute('aria-current', 'location')
            } else if (a.getAttribute('aria-current')) {
              a.removeAttribute('aria-current')
            }
          }),
        { rootMargin: '-45% 0px -50% 0px' },
      )
      spyLinks.forEach((_, id) => {
        const el = document.getElementById(id)
        if (el) spy.observe(el)
      })
    </script>
  </body>
</html>
