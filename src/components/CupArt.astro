---
// Iced cold brew in a tumbler with longan-honey layer and an orange peel twist.
---
<svg class="cup-art" viewBox="0 0 320 340" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ca-brew" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8a5a3a" />
      <stop offset="0.55" stop-color="#5a3624" />
      <stop offset="1" stop-color="#3d2418" />
    </linearGradient>
    <linearGradient id="ca-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="0.25" stop-color="#fff" stop-opacity="0.08" />
      <stop offset="1" stop-color="#fff" stop-opacity="0.25" />
    </linearGradient>
  </defs>
  <circle cx="160" cy="176" r="138" fill="#e7c7a4" />
  <circle cx="160" cy="176" r="138" fill="none" stroke="#b65a37" stroke-width="2" stroke-dasharray="4 10" opacity="0.6" />
  <ellipse cx="160" cy="306" rx="86" ry="12" fill="#3a2a1f" opacity="0.18" />
  <!-- straw -->
  <path d="M184 30 L170 120" stroke="#46573a" stroke-width="10" stroke-linecap="round" />
  <!-- glass -->
  <path d="M92 96 H228 L214 290 Q160 304 106 290 Z" fill="url(#ca-brew)" />
  <path d="M100 210 H220 L216 246 Q160 258 104 246 Z" fill="#d89a52" opacity="0.55" />
  <g fill="#fbf5ea" opacity="0.5">
    <rect x="112" y="108" width="40" height="36" rx="8" transform="rotate(-10 132 126)" />
    <rect x="160" y="118" width="38" height="34" rx="8" transform="rotate(12 179 135)" />
    <rect x="128" y="150" width="34" height="32" rx="8" transform="rotate(6 145 166)" />
  </g>
  <path d="M92 96 H228 L214 290 Q160 304 106 290 Z" fill="url(#ca-glass)" />
  <path d="M88 92 H232" stroke="#fbf5ea" stroke-width="6" stroke-linecap="round" opacity="0.9" />
  <!-- orange peel twist -->
  <path d="M206 92 C232 70 262 76 266 100 C250 92 232 96 220 108 Z" fill="#e08a3a" />
  <path d="M212 96 C232 82 252 84 258 96" stroke="#f6c27a" stroke-width="3" fill="none" stroke-linecap="round" />
</svg>

<style>
  .cup-art {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
