---
// Wide dawn landscape over layered northern mountains, mist, and a coffee branch.
// Drawn on a 1440x900 canvas; the hero anchors it bottom-right so narrow screens keep the sun + branch.
interface Props {
  label: string
}
const { label } = Astro.props
---
<svg class="hero-art" viewBox="0 0 1440 900" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#efdcc3" />
      <stop offset="0.55" stop-color="#f3e2cb" />
      <stop offset="1" stop-color="#f1dcc0" />
    </linearGradient>
    <linearGradient id="ha-mist" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fbf5ea" stop-opacity="0" />
      <stop offset="0.5" stop-color="#fbf5ea" stop-opacity="0.9" />
      <stop offset="1" stop-color="#fbf5ea" stop-opacity="0" />
    </linearGradient>
    <radialGradient id="ha-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#f2b27f" stop-opacity="0.55" />
      <stop offset="1" stop-color="#f2b27f" stop-opacity="0" />
    </radialGradient>
  </defs>

  <rect width="1440" height="900" fill="url(#ha-sky)" />
  <circle cx="1060" cy="470" r="260" fill="url(#ha-glow)" />
  <circle class="ha-sun" cx="1060" cy="470" r="112" fill="#d4764a" />

  <g class="ha-birds" fill="none" stroke="#7a5238" stroke-width="3" stroke-linecap="round" opacity="0.55">
    <path d="M880 300 q10 -10 20 0 q10 -10 20 0" />
    <path d="M930 260 q7 -7 14 0 q7 -7 14 0" />
  </g>

  <path d="M0 700 L120 668 L240 686 L380 630 L520 660 L660 600 L800 612 L940 506 L1060 566 L1180 476 L1320 548 L1440 506 V900 H0Z" fill="#c3c2a2" />
  <rect class="ha-mist m1" x="760" y="596" width="760" height="34" rx="17" fill="url(#ha-mist)" />
  <path d="M0 744 L150 700 L310 728 L470 676 L630 702 L790 622 L940 672 L1090 604 L1230 660 L1350 616 L1440 642 V900 H0Z" fill="#8f9b75" />
  <rect class="ha-mist m2" x="700" y="650" width="820" height="30" rx="15" fill="url(#ha-mist)" />
  <path d="M0 772 Q180 704 360 748 T720 732 T1080 716 T1440 738 V900 H0Z" fill="#5d6b4b" />
  <g fill="#4b5a3c">
    <ellipse cx="250" cy="742" rx="16" ry="22" />
    <ellipse cx="276" cy="748" rx="12" ry="17" />
    <ellipse cx="880" cy="726" rx="15" ry="21" />
    <ellipse cx="904" cy="733" rx="11" ry="15" />
    <ellipse cx="1250" cy="728" rx="14" ry="20" />
  </g>
  <g stroke="#73805d" stroke-width="3" fill="none" opacity="0.7" stroke-linecap="round">
    <path d="M60 812 Q300 770 560 800" />
    <path d="M640 806 Q900 772 1180 790" />
    <path d="M120 842 Q380 806 660 830" />
  </g>
  <path d="M0 846 Q240 798 520 830 T1040 816 T1440 824 V900 H0Z" fill="#3a2a1f" />

  <!-- coffee branch -->
  <g transform="translate(860 30)">
    <g class="ha-branch">
      <path d="M600 120 C520 170 470 230 430 330 C410 380 395 420 380 470" fill="none" stroke="#5a3a26" stroke-width="7" stroke-linecap="round" />
      <path d="M520 175 C560 150 590 160 600 180 C570 200 540 196 520 175Z" fill="#46573a" />
      <path d="M500 195 C480 150 490 120 515 112 C528 145 522 175 500 195Z" fill="#6a7b52" />
      <path d="M455 270 C500 255 530 268 540 292 C505 305 475 296 455 270Z" fill="#46573a" />
      <path d="M445 285 C410 260 405 228 425 212 C448 236 455 262 445 285Z" fill="#6a7b52" />
      <path d="M405 400 C440 395 465 410 470 432 C440 440 418 428 405 400Z" fill="#6a7b52" />
      <circle cx="470" cy="232" r="13" fill="#b8402c" />
      <circle cx="490" cy="246" r="12" fill="#9a3220" />
      <circle cx="466" cy="256" r="11" fill="#d05a3a" />
      <circle cx="415" cy="350" r="12" fill="#b8402c" />
      <circle cx="433" cy="362" r="11" fill="#d97a4a" />
      <circle cx="412" cy="372" r="10" fill="#9a3220" />
      <g fill="#fff" opacity="0.55">
        <circle cx="465" cy="227" r="3" />
        <circle cx="486" cy="241" r="2.5" />
        <circle cx="411" cy="345" r="2.6" />
      </g>
    </g>
  </g>
</svg>

<style>
  .hero-art {
    display: block;
  }
  .ha-mist {
    animation: ha-drift 16s ease-in-out infinite alternate;
  }
  .m2 {
    animation-duration: 20s;
    animation-direction: alternate-reverse;
  }
  .ha-sun {
    animation: ha-rise 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .ha-branch {
    transform-box: fill-box;
    transform-origin: 100% 0;
    animation: ha-sway 7s ease-in-out infinite alternate;
  }
  @keyframes ha-drift {
    to {
      transform: translateX(80px);
    }
  }
  @keyframes ha-rise {
    from {
      transform: translateY(90px);
      opacity: 0;
    }
  }
  @keyframes ha-sway {
    to {
      transform: rotate(2deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ha-mist,
    .ha-sun,
    .ha-branch {
      animation: none;
    }
  }
</style>
