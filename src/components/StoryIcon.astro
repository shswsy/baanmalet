---
interface Props {
  kind: 0 | 1 | 2
}
const { kind } = Astro.props
---
<svg class="story-icon" viewBox="0 0 96 96" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <circle cx="48" cy="48" r="46" fill="var(--cream-2)" />
  {
    kind === 0 && (
      <g>
        <path d="M48 18 C44 30 40 34 30 40" stroke="var(--brown)" stroke-width="3" fill="none" stroke-linecap="round" />
        <path d="M48 18 C60 16 70 22 72 32 C60 34 52 28 48 18Z" fill="var(--forest-2)" />
        <circle cx="34" cy="52" r="11" fill="var(--terra)" />
        <circle cx="52" cy="58" r="12" fill="#a8321f" />
        <circle cx="40" cy="70" r="10" fill="#d9573a" />
        <circle cx="31" cy="48" r="2.5" fill="#fff" opacity="0.6" />
      </g>
    )
  }
  {
    kind === 1 && (
      <g>
        <rect x="22" y="34" width="44" height="34" rx="17" fill="var(--forest)" />
        <circle cx="44" cy="51" r="9" fill="none" stroke="var(--cream)" stroke-width="3" />
        <path d="M66 46 H76 L80 40" stroke="var(--forest)" stroke-width="4" fill="none" stroke-linecap="round" />
        <path d="M28 68 L24 80 M60 68 L64 80" stroke="var(--brown)" stroke-width="4" stroke-linecap="round" />
        <path d="M34 26 c0-6 6-6 6-12 M48 26 c0-6 6-6 6-12" stroke="var(--terra)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </g>
    )
  }
  {
    kind === 2 && (
      <g>
        <path d="M26 40 H62 V58 C62 70 54 76 44 76 C34 76 26 70 26 58 Z" fill="var(--terra)" />
        <path d="M62 46 C72 46 72 60 62 60" stroke="var(--terra)" stroke-width="4" fill="none" />
        <rect x="22" y="76" width="48" height="5" rx="2.5" fill="var(--brown)" />
        <path d="M36 32 c-4-5 4-8 0-14 M46 32 c-4-5 4-8 0-14 M56 32 c-4-5 4-8 0-14" stroke="var(--forest-2)" stroke-width="2.5" fill="none" stroke-linecap="round" />
      </g>
    )
  }
</svg>

<style>
  .story-icon {
    width: 76px;
    height: 76px;
    display: block;
  }
</style>
